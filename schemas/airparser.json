{
  "openapi": "3.0.3",
  "info": {
    "title": "Airparser API",
    "description": "Airparser is a document parsing service that extracts structured data from various document formats using AI. This API allows you to upload documents, manage inboxes, configure extraction schemas, and retrieve parsed data.",
    "version": "1.0.0",
    "contact": {
      "name": "Airparser Support",
      "email": "support@airparser.com",
      "url": "https://airparser.com"
    },
    "license": {
      "name": "Terms of Service",
      "url": "https://airparser.com/terms/"
    }
  },
  "servers": [
    {
      "url": "https://api.airparser.com",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/inboxes": {
      "get": {
        "summary": "List inboxes",
        "description": "Retrieve a list of all inboxes associated with your account",
        "operationId": "listInboxes",
        "responses": {
          "200": {
            "description": "List of inboxes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Inbox"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "tags": ["Inboxes"]
      }
    },
    "/inboxes/{inbox_id}": {
      "delete": {
        "summary": "Delete an inbox",
        "description": "Delete a specific inbox by its ID",
        "operationId": "deleteInbox",
        "parameters": [
          {
            "name": "inbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the inbox to delete"
          }
        ],
        "responses": {
          "200": {
            "description": "Inbox deleted successfully"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Inbox not found"
          }
        },
        "tags": ["Inboxes"]
      }
    },
    "/inboxes/{inbox_id}/upload": {
      "post": {
        "summary": "Upload a document",
        "description": "Upload a document to a specific inbox for parsing. Supported formats include EML, PDF, HTML, TXT, MD and more. Maximum file size is 20MB.",
        "operationId": "uploadDocument",
        "parameters": [
          {
            "name": "inbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the inbox to upload the document to"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The document file to upload"
                  },
                  "meta": {
                    "type": "string",
                    "description": "Optional JSON string containing metadata that will be included in the parsed JSON as the __meta__ field",
                    "example": "{\"foo\": \"bar\", \"my_id\": 42}"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "document_id": {
                      "type": "string",
                      "description": "The ID of the uploaded document"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid file or parameters"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "description": "File too large (max 20MB)"
          }
        },
        "tags": ["Documents"]
      }
    },
    "/inboxes/{inbox_id}/docs": {
      "get": {
        "summary": "List documents",
        "description": "Retrieve a list of documents from a specific inbox with optional filtering",
        "operationId": "listDocuments",
        "parameters": [
          {
            "name": "inbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the inbox"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Page number for pagination"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter documents from this date (YYYY-MM-DD format)"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter documents to this date (YYYY-MM-DD format)"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search query to filter documents"
          },
          {
            "name": "statuses",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["importing", "parsed", "fail", "new", "quota", "parsing", "exception"]
              }
            },
            "style": "form",
            "explode": true,
            "description": "Filter by document processing statuses"
          }
        ],
        "responses": {
          "200": {
            "description": "List of documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "documents": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Document"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Inbox not found"
          }
        },
        "tags": ["Documents"]
      }
    },
    "/docs/{document_id}/extended": {
      "get": {
        "summary": "Get a document",
        "description": "Retrieve the parsed data for a specific document as JSON. Note: Using webhooks for real-time data is recommended instead.",
        "operationId": "getDocument",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the document to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Document data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentData"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Document not found"
          }
        },
        "tags": ["Documents"]
      }
    },
    "/inboxes/{inbox_id}/schema": {
      "post": {
        "summary": "Create/edit an extraction schema",
        "description": "Updates or creates an extraction schema for a specific inbox. The schema defines how documents should be parsed and what data should be extracted.",
        "operationId": "updateExtractionSchema",
        "parameters": [
          {
            "name": "inbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the inbox"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractionSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Schema updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "description": "Returns true if the schema was successfully updated"
                }
              }
            }
          },
          "400": {
            "description": "Invalid schema format or validation errors"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Inbox not found"
          }
        },
        "tags": ["Extraction Schema"]
      }
    },
    "/inboxes/{inbox_id}/schema-clone": {
      "post": {
        "summary": "Clone an extraction schema between inboxes",
        "description": "Clone an extraction schema from one inbox to another",
        "operationId": "cloneExtractionSchema",
        "parameters": [
          {
            "name": "inbox_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The source inbox ID from which the extraction schema will be cloned"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "destination_inbox_id": {
                    "type": "string",
                    "description": "The target inbox ID where the extraction schema will be copied"
                  }
                },
                "required": ["destination_inbox_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Schema cloned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "description": "Returns true if the schema was successfully cloned"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Source or destination inbox not found"
          }
        },
        "tags": ["Extraction Schema"]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for authentication. You can find your API key in your Airparser account settings."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized - Invalid or missing API key",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Inbox": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the inbox"
          },
          "name": {
            "type": "string",
            "description": "Name of the inbox"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the document"
          },
          "filename": {
            "type": "string",
            "description": "Original filename of the uploaded document"
          },
          "status": {
            "type": "string",
            "enum": ["importing", "parsed", "fail", "new", "quota", "parsing", "exception"],
            "description": "Current processing status of the document"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Upload timestamp"
          },
          "processed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Processing completion timestamp",
            "nullable": true
          }
        }
      },
      "DocumentData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Document ID"
          },
          "extracted_data": {
            "type": "object",
            "description": "The extracted structured data based on the extraction schema",
            "additionalProperties": true
          },
          "__meta__": {
            "type": "object",
            "description": "Optional metadata that was provided during upload",
            "additionalProperties": true
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "description": "Current page number"
          },
          "total_pages": {
            "type": "integer",
            "description": "Total number of pages"
          },
          "total_items": {
            "type": "integer",
            "description": "Total number of items"
          },
          "per_page": {
            "type": "integer",
            "description": "Items per page"
          }
        }
      },
      "ExtractionSchema": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ScalarField"
                },
                {
                  "$ref": "#/components/schemas/ListField"
                },
                {
                  "$ref": "#/components/schemas/ObjectField"
                },
                {
                  "$ref": "#/components/schemas/EnumField"
                }
              ]
            }
          }
        },
        "required": ["fields"]
      },
      "ScalarField": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["scalar"]
          },
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,100}$",
                "description": "Field name (lowercase letters, numbers, underscores only)"
              },
              "description": {
                "type": "string",
                "maxLength": 3000,
                "description": "Field description"
              },
              "type": {
                "type": "string",
                "enum": ["string", "integer", "decimal", "boolean"],
                "description": "Data type for the field"
              },
              "default_value": {
                "type": "string",
                "maxLength": 400,
                "description": "Default value if field is not found"
              }
            },
            "required": ["name", "description", "type"]
          }
        },
        "required": ["type", "data"]
      },
      "ListField": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["list"]
          },
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,100}$",
                "description": "Field name (lowercase letters, numbers, underscores only)"
              },
              "description": {
                "type": "string",
                "maxLength": 3000,
                "description": "Field description"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldAttribute"
                }
              }
            },
            "required": ["name", "description", "attributes"]
          }
        },
        "required": ["type", "data"]
      },
      "ObjectField": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["object"]
          },
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,100}$",
                "description": "Field name (lowercase letters, numbers, underscores only)"
              },
              "description": {
                "type": "string",
                "maxLength": 3000,
                "description": "Field description"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldAttribute"
                }
              }
            },
            "required": ["name", "description", "attributes"]
          }
        },
        "required": ["type", "data"]
      },
      "EnumField": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["enum"]
          },
          "data": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,100}$",
                "description": "Field name (lowercase letters, numbers, underscores only)"
              },
              "description": {
                "type": "string",
                "maxLength": 3000,
                "description": "Field description"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "uniqueItems": true,
                "description": "Array of possible enum values"
              }
            },
            "required": ["name", "description", "values"]
          }
        },
        "required": ["type", "data"]
      },
      "FieldAttribute": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,100}$",
            "description": "Attribute name (lowercase letters, numbers, underscores only)"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "description": "Attribute description"
          },
          "type": {
            "type": "string",
            "enum": ["string", "integer", "decimal", "boolean"],
            "description": "Data type for the attribute"
          },
          "default_value": {
            "type": "string",
            "maxLength": 400,
            "description": "Default value if attribute is not found"
          }
        },
        "required": ["name", "description", "type"]
      }
    }
  },
  "tags": [
    {
      "name": "Documents",
      "description": "Operations for uploading and managing documents"
    },
    {
      "name": "Inboxes",
      "description": "Operations for managing inboxes"
    },
    {
      "name": "Extraction Schema",
      "description": "Operations for configuring document parsing schemas"
    }
  ]
}
